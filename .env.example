# Ambiente: development | production | test
NODE_ENV=development

# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# Banco de dados (PostgreSQL é o único provider suportado)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/greencode?schema=public"

# Segredo de assinatura do JWT (obrigatório; em produção use no mínimo 32 caracteres)
# Gere um valor seguro com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque_por_um_segredo_longo_e_aleatorio"

# Validade do token (número + s|m|h|d). Padrão: 8h. Em produção, prefira valores curtos (ex.: 1h).
JWT_EXPIRES_IN=8h
# Emissor e público do token; tokens com valores diferentes são rejeitados.
JWT_ISSUER=greencode-api
JWT_AUDIENCE=greencode-clients

# Nível de log: fatal | error | warn | info | debug | trace | silent
# Padrão: info (production), debug (development), silent (test)
# LOG_LEVEL=info

# Rate Limiting (mitigação de força bruta e abuso da API)
# Limite global (padrão: 100 requisições por minuto)
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_GLOBAL_TIME_WINDOW="1 minute"
# Limite no endpoint de autenticação (padrão: 5 tentativas por minuto por IP)
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_TIME_WINDOW="1 minute"

# Origens permitidas para CORS (separadas por vírgula). Obrigatória em produção.
# Padrão fora de produção: * (permite qualquer origem)
# CORS_ORIGINS="https://app.greencode.com.br,https://admin.greencode.com.br"

# Apenas para o seed (npm run db:seed). Obrigatória fora de development/test.
# SEED_ADMIN_PASSWORD=
